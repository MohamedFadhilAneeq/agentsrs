# Copy this file to .env and fill in your keys
# rename: cp .env.example .env

LLM_PROVIDER=groq

# --- Groq settings ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_primary_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: extra keys for round-robin rotation (avoids rate limits during eval)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
